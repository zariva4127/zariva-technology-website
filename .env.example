# Copy these into your hosting provider's environment settings.
NODE_ENV=production
PORT=3000
ADMIN_PASSWORD=use-a-long-random-password
SITE_URL=https://www.your-domain.com
# Optional: Slack/Discord/Zapier webhook pinged for every new enquiry or subscriber
NOTIFY_WEBHOOK_URL=
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=1
